{
  "manifest_version": 3,
  "name": "Google Chat: links no navegador padrão",
  "version": "0.1.0",
  "description": "Abre os links clicados no PWA do Google Chat no navegador padrão do macOS.",
  "key": "",
  "permissions": ["nativeMessaging", "webNavigation"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*"],
      "js": ["links.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
